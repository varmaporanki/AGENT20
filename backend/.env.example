# Agent 20 Backend Configuration Template
# Duplicate this file to .env and configure local values

# PostgreSQL 16 Database Connection String
DATABASE_URL=postgresql://postgres:<your-postgres-password>@localhost:5432/acadagents

# Connection Pool Settings
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=5

# Analytics & Scoring Configuration
EVALUATION_DATE=2024-12-31

# Gemini AI Service Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=30.0
GEMINI_MAX_OUTPUT_TOKENS=2048

# CORS Allowed Origins (Comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:8080

# Server Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
