# ============================================================================
# AGENT 20 — BACKEND CONFIGURATION TEMPLATE (.env.example)
# Copy to backend/.env and populate with local credentials.
# NEVER COMMIT ACTUAL API KEYS OR PASSWORDS TO SOURCE CONTROL.
# ============================================================================

# Database Connection (PostgreSQL 16)
DB_NAME=acadagents
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# AI Provider Credentials (SERVER-SIDE ONLY)
GROQ_API_KEY=
OPENAI_API_KEY=

# AI Model Selection
GROQ_MODEL=groq/compound-mini
OPENAI_MODEL=gpt-4o-mini

# AI Multi-Provider Fallback Configuration
AI_PROVIDER_PRIORITY=groq,openai
AI_TIMEOUT_SECONDS=15
